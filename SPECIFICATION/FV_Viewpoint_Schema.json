{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/memoryprismv1/faking-vision/blob/main/SPECIFICATION/FV_Viewpoint_Schema.json",
  "title": "FV Viewpoint Records and Reusable Viewpoint Objects",
  "description": "Root-level viewpoint.json array. Each record preserves source viewpoint initialisation and may also define a reusable, editable rendering viewpoint (VPO).",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "observer",
      "initial_state"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^VP-(?!DEFAULT$)[A-Za-z0-9][A-Za-z0-9_-]{7,}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string",
        "enum": [
          "source",
          "render_preset",
          "source_and_render"
        ]
      },
      "is_default": {
        "type": "boolean",
        "description": "Exactly one record may be true when a packet declares a default render viewpoint."
      },
      "observer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      },
      "initial_state": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "known",
              "partially_known",
              "unknown"
            ]
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "orientation": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "coordinate_frame": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "handedness",
          "up_axis",
          "units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "handedness": {
            "const": "right"
          },
          "up_axis": {
            "const": "+Y"
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      },
      "pose": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "orientation",
          "projection",
          "framing"
        ],
        "properties": {
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "orientation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "representation",
              "yaw",
              "pitch",
              "roll",
              "unit",
              "rotation_order"
            ],
            "properties": {
              "representation": {
                "const": "intrinsic_euler"
              },
              "yaw": {
                "type": "number"
              },
              "pitch": {
                "type": "number"
              },
              "roll": {
                "type": "number"
              },
              "unit": {
                "const": "degrees"
              },
              "rotation_order": {
                "const": "Y-X-Z"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "target": {
            "$ref": "#/$defs/vector3"
          },
          "projection": {
            "type": "string",
            "enum": [
              "perspective",
              "orthographic"
            ]
          },
          "field_of_view_degrees": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 179
          },
          "orthographic_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "framing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aspect_ratio",
              "fit"
            ],
            "properties": {
              "aspect_ratio": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover",
                  "exact"
                ]
              },
              "center": {
                "$ref": "#/$defs/vector2"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "position_units": {
                "type": "number",
                "minimum": 0
              },
              "rotation_degrees": {
                "type": "number",
                "minimum": 0
              },
              "framing_percent": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "image_anchor": {
            "$ref": "#/$defs/imageAnchor",
            "description": "Normalized image-space location of the editor camera marker; this is not a physical camera position."
          }
        }
      },
      "metadata": {
        "type": "object",
        "additionalProperties": true,
        "description": "Editor and renderer annotations that do not alter the canonical camera pose."
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "imageAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
